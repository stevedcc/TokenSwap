{
  // Renovate for tswap (owner, 2026-11-14), modelled on Croft's, reviewed by MiMo and DeepSeek (PR #308). The hosted
  // Mend Renovate GitHub App runs it.
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
    ':semanticCommitsDisabled',
    'helpers:pinGitHubActionDigests', // actions and reusable workflows pinned by SHA, with a version comment
  ],
  timezone: 'Europe/Berlin',
  // Supply-chain guard: no PR until a release is 3 days old (yanked or compromised releases are usually withdrawn
  // within days). Without prCreation 'not-pending' Renovate would open the PR at once and only hold automerge back.
  // A security fix skips the wait (vulnerabilityAlerts below). An action digest move is aged by its tag's commit
  // date as well, and on top of that is never automerged and waits for the Dependency Dashboard (the actions rules).
  minimumReleaseAge: '3 days',
  prCreation: 'not-pending',
  internalChecksFilter: 'strict',
  // tswap's CI runs on pull_request (and pushes to main), never on a Renovate branch before its PR exists, so the
  // passed release-age check alone must be enough to open the PR (review of PR #308); automerge still waits for CI,
  // which main's ruleset requires too.
  internalChecksAsSuccess: true,
  prConcurrentLimit: 5,
  prHourlyLimit: 0,
  labels: ['dependencies'],
  // main has no branch protection requiring CI, so GitHub's own auto-merge (platformAutomerge) could merge a PR
  // whose CI hasn't finished or failed. Renovate's own automerge merges only when every check on the branch is green.
  platformAutomerge: false,
  customManagers: [
    {
      customType: 'regex',
      description: 'ssign, the Windows signing tool, is built in release.yml from a commit pinned with cargo install --rev; the # vX.Y.Z comment at the end of that line is its version',
      managerFilePatterns: ['/^\\.github/workflows/release\\.yml$/'],
      matchStrings: ['cargo install[^\\n#]*--git https://github\\.com/(?<depName>Le-Syl21/ssign) --rev (?<currentDigest>[0-9a-f]{40})[^\\n#]* # (?<currentValue>v\\d+\\.\\d+\\.\\d+)\\s*\\n'],
      datasourceTemplate: 'github-tags',
      versioningTemplate: 'semver',
      packageNameTemplate: 'Le-Syl21/ssign',
    },
  ],
  // tswap releases are manual tags, so Croft's automergeStrategy 'rebase' (kept for its auto-release workflow) isn't
  // needed here.
  packageRules: [
    // Brief T57 (#420): the NuGet manager updates the packages.lock.json files in the same PR as a bump (and for a
    // global.json change too), so no lock-file option is needed. lockFileMaintenance stays off on purpose: NuGet picks
    // the lowest version that satisfies each range, so regenerating an unchanged lock file changes nothing, and
    // transitive versions move only when a direct package's bump moves them.
    {
      description: 'NuGet: an update always comes as a PR and keeps an exact version exact. NuGet reads a plain 1.2.3 as a minimum; [1.2.3] is exact, which is how tswap pins.',
      matchDatasources: ['nuget'],
      rangeStrategy: 'pin',
    },
    {
      description: 'Majors are planned work (a .NET version, xunit v3): no PR until ticked on the Dependency Dashboard',
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
    {
      description: 'Test packages, one PR; patches separate from minors, so an automerged patch never carries a minor along',
      matchDatasources: ['nuget'],
      matchPackageNames: ['Microsoft.NET.Test.Sdk', '/^xunit/'],
      groupName: 'test packages',
      separateMinorPatch: true,
    },
    {
      description: 'Automerge what CI can judge: test package patches',
      matchDatasources: ['nuget'],
      matchPackageNames: ['Microsoft.NET.Test.Sdk', '/^xunit/'],
      matchUpdateTypes: ['patch'],
      automerge: true,
      automergeType: 'pr',
    },
    {
      description: 'GitHub Actions: only the first pin (recording the SHA the tag points to today) automerges',
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['pinDigest'],
      automerge: true,
      automergeType: 'pr',
    },
    {
      description: 'GitHub Actions: a digest change means a version tag moved (how the wfx-loot campaign and similar attacks arrive). Never automerged, and no PR until ticked on the Dependency Dashboard. A new action version is an ordinary PR.',
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['digest'],
      automerge: false,
      dependencyDashboardApproval: true,
      addLabels: ['action-digest-move'],
    },
    {
      description: 'global.json SDK (datasource dotnet-version): a new feature band (11.0.200) or .NET 12 is a decision, shown on the Dependency Dashboard',
      matchDatasources: ['dotnet-version'],
      dependencyDashboardApproval: true,
    },
    {
      description: 'global.json SDK: a patch inside the pinned feature band 11.0.1xx automerges (after the catch-all rule above, so it wins). The PR carries the regenerated packages.lock.json files (the SDK brings the ILCompiler and ILLink packages they pin), and CI checks them: a PR without them fails the locked restore.',
      matchDatasources: ['dotnet-version'],
      matchNewValue: '/^11\\.0\\.1\\d\\d$/',
      dependencyDashboardApproval: false,
      automerge: true,
      automergeType: 'pr',
    },
    {
      description: 'ssign (the Windows signing tool; it handles the signing login): never automerged, no PR until ticked on the Dependency Dashboard, and the 3-day minimumReleaseAge above applies. Each bump: read the ssign diff, then one dry run (Release, Run workflow with `dry_run`, on the Renovate branch before you merge if the windows-signing environment allows that branch, else on main before you tag), which signs with a real code and publishes nothing, before tagging (docs/windows-signing.md).',
      matchManagers: ['custom.regex'],
      matchPackageNames: ['Le-Syl21/ssign'],
      automerge: false,
      dependencyDashboardApproval: true,
      addLabels: ['signing-tool'],
    },
    {
      description: 'Security-critical packages: keys, crypto, the PTY, CBOR (FIDO2 messages), Otp.NET (TOTP codes from a stored seed). Never automerged: CI cannot run the hardware tests, so the owner decides (a Yubico SDK bump wants the B6 suite on the spare key). KEEP THIS RULE LAST: later packageRules win, so nothing after it may set automerge for these packages.',
      matchDatasources: ['nuget'],
      matchPackageNames: [
        'Yubico.YubiKey',
        'BouncyCastle.Cryptography',
        'Konscious.Security.Cryptography.Argon2',
        'RedactingPty',
        'System.Formats.Cbor',
        'Otp.NET',
      ],
      groupName: 'security-critical packages',
      groupSlug: 'security-critical',
      automerge: false,
      addLabels: ['security-critical'],
    },
  ],
  // A fix for a known vulnerability doesn't wait for the release age. It sets no automerge, so the security-critical
  // rule still holds for those packages; addLabels keeps their security-critical label.
  vulnerabilityAlerts: { enabled: true, addLabels: ['security'], minimumReleaseAge: null, prCreation: 'immediate' },
  osvVulnerabilityAlerts: true,
}
