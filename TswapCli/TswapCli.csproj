<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tswap</AssemblyName>
    <RootNamespace>TswapCli</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.2.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Size</OptimizationPreference>
    <!-- LibraryImport's generated stubs (PcscStrategy.cs) need /unsafe, as in TswapCore. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TswapCore\TswapCore.csproj" />
    <PackageReference Include="RedactingPty" Version="1.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TswapTests" />
  </ItemGroup>

  <!--
    YubiKey SDK, Linux NativeAOT publish only: libpcsclite is used when present, never required (design
    docs/superpowers/specs/2026-11-04-yubikey-sdk-portable-design.md, "Constraints").
    Yubico.NativeShims' build targets link its static archive and add -lpcsclite (target
    _YubicoNativeShimsConfigureAot), which would give tswap a NEEDED entry for libpcsclite.so.1. Instead
    Native/pcsc-loader.c defines the archive's 11 PC/SC functions (forwarding to libpcsclite.so.1 through dlopen
    when it is there, a SCARD_E_NO_SERVICE stand-in otherwise) and tswap_pcsc_strategy(), compiled with the
    compiler the AOT link uses ($(CppCompilerAndLinker)) into one static archive, libtswap_pcsc.a:
    - TswapBuildPcscLoader (before SetupOSSpecificProps, which puts NativeLibrary items on the link line) runs the
      canary, compiles the archive and adds it as a NativeLibrary. Added in a target, it lands after the SDK's
      archive, so GNU ld resolves the SDK's references to the 11 from it. Only the archive, never the object too
      (that would define the 11 twice).
    - The canary: `nm -u` of the SDK archive of the rid being published must list exactly the 11 SCard functions
      and no g_rgSCard*Pci data (the loader defines no data symbols), else the build fails: an SDK update that
      calls a 12th function, or reads pcsc-lite's PCI structures, is loud.
    - TswapRemoveSdkPcscliteLink (before LinkNative, so it runs even if the SDK renames its target) removes the
      SDK's -lpcsclite and fails if it wasn't there.
    macOS and Windows keep the SDK's own linking (PCSC.framework, winscard.lib), which every such system has.
  -->
  <PropertyGroup>
    <TswapPcscLoader Condition="'$(PublishAot)' == 'true' and $(RuntimeIdentifier.StartsWith('linux-'))">true</TswapPcscLoader>
  </PropertyGroup>

  <ItemGroup Condition="'$(TswapPcscLoader)' == 'true'">
    <DirectPInvoke Include="tswap_pcsc" />
  </ItemGroup>

  <Target Name="TswapBuildPcscLoader" BeforeTargets="SetupOSSpecificProps" Condition="'$(TswapPcscLoader)' == 'true'">
    <PropertyGroup>
      <_TswapPcscSource>$(MSBuildProjectDirectory)/Native/pcsc-loader.c</_TswapPcscSource>
      <_TswapPcscDir>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)tswap_pcsc/</_TswapPcscDir>
      <_TswapPcscObject>$(_TswapPcscDir)pcsc-loader.o</_TswapPcscObject>
      <_TswapPcscArchive>$(_TswapPcscDir)libtswap_pcsc.a</_TswapPcscArchive>
      <_TswapPcscExpected>SCardBeginTransaction SCardCancel SCardConnect SCardDisconnect SCardEndTransaction SCardEstablishContext SCardGetStatusChange SCardListReaders SCardReconnect SCardReleaseContext SCardTransmit</_TswapPcscExpected>
      <!-- Cross-compiling (host rid differs): the triple the AOT link derives the same way (SetupOSSpecificProps). -->
      <_TswapPcscTarget Condition="'$(NETCoreSdkPortableRuntimeIdentifier)' != '$(RuntimeIdentifier)' and $(RuntimeIdentifier.EndsWith('-x64'))">--target=x86_64-linux-gnu</_TswapPcscTarget>
      <_TswapPcscTarget Condition="'$(NETCoreSdkPortableRuntimeIdentifier)' != '$(RuntimeIdentifier)' and $(RuntimeIdentifier.EndsWith('-arm64'))">--target=aarch64-linux-gnu</_TswapPcscTarget>
      <_TswapPcscSysRoot Condition="'$(SysRoot)' != ''">--sysroot=&quot;$(SysRoot)&quot;</_TswapPcscSysRoot>
    </PropertyGroup>

    <Error Condition="'@(_YubicoNativeShimsStaticArchive->Count())' != '1'"
           Text="tswap: expected one Yubico.NativeShims static archive for $(RuntimeIdentifier), found '@(_YubicoNativeShimsStaticArchive)' (the SDK's build targets changed; check TswapCli.csproj's PC/SC loader)." />
    <Exec Command="nm -u &quot;@(_YubicoNativeShimsStaticArchive)&quot; | grep -oE '\b(SCard[A-Za-z]+|g_rgSCard[A-Za-z0-9]+)\b' | LC_ALL=C sort -u | tr '\n' ' '"
          ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_TswapPcscFound" />
    </Exec>
    <Error Condition="'$(_TswapPcscFound.Trim())' != '$(_TswapPcscExpected)'"
           Text="tswap: Yubico.NativeShims' archive (@(_YubicoNativeShimsStaticArchive)) references PC/SC symbols [$(_TswapPcscFound.Trim())], not the 11 Native/pcsc-loader.c defines [$(_TswapPcscExpected)]. Update the loader for this SDK version before publishing." />

    <MakeDir Directories="$(_TswapPcscDir)" />
    <Delete Files="$(_TswapPcscArchive)" />
    <Exec Command="&quot;$(CppCompilerAndLinker)&quot; $(_TswapPcscTarget) $(_TswapPcscSysRoot) -c -std=c11 -O2 -fPIC -fvisibility=hidden -pthread -Wall -Wextra -Werror &quot;$(_TswapPcscSource)&quot; -o &quot;$(_TswapPcscObject)&quot;" />
    <Exec Command="&quot;$(CppLibCreator)&quot; crs &quot;$(_TswapPcscArchive)&quot; &quot;$(_TswapPcscObject)&quot;" />

    <ItemGroup>
      <NativeLibrary Include="$(_TswapPcscArchive)" />
    </ItemGroup>
  </Target>

  <Target Name="TswapRemoveSdkPcscliteLink" BeforeTargets="LinkNative" Condition="'$(TswapPcscLoader)' == 'true'">
    <ItemGroup>
      <_TswapSdkPcscliteArg Include="@(LinkerArg)" Condition="'%(Identity)' == '-lpcsclite'" />
    </ItemGroup>
    <Error Condition="'@(_TswapSdkPcscliteArg)' == ''"
           Text="tswap: the Yubico.NativeShims build targets no longer add the -lpcsclite LinkerArg this project removes (target _YubicoNativeShimsConfigureAot). Check how the SDK links PC/SC now before publishing." />
    <ItemGroup>
      <LinkerArg Remove="-lpcsclite" />
    </ItemGroup>
  </Target>

</Project>
