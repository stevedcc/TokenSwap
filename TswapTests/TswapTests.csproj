<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- TswapCli is a RID-specific (self-contained-on-publish) exe; referencing it from
         this RID-agnostic test project is fine for in-process command tests. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- GHSA-vmv3-wvjp-wqpj (CVE-2026-118747): Yubico.YubiKey 1.18.1 brings System.Formats.Cbor 10.0.14; the fixed 11.0.0 -->
    <PackageReference Include="System.Formats.Cbor" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TswapCore\TswapCore.csproj" />
    <ProjectReference Include="..\TswapCli\TswapCli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
